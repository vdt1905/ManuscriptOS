# Copy to terraform.tfvars (gitignored) and fill in.

# Required: MongoDB Atlas free (M0) connection string.
mongo_uri = "mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hackamined?appName=Cluster0"

# AI features
groq_api_key = "gsk_..."

# Get an email if AWS ever starts charging (recommended).
alert_email = "you@example.com"

# Optional
# cloudinary_cloud_name = ""
# cloudinary_api_key    = ""
# cloudinary_api_secret = ""
# openai_api_key        = ""
# github_token          = ""

# Defaults you can change
# region            = "ap-south-1"
# instance_type     = "t3.micro"
# github_repository = "vdt1905/ManuscriptOS"
# create_github_oidc_provider = false   # if your account already has one
